# Coinbase Developer Platform (CDP) API Credentials
# Create these keys at https://portal.cdp.coinbase.com/
COINBASE_API_KEY=organizations/YOUR_ORG_ID/apiKeys/YOUR_KEY_ID
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END EC PRIVATE KEY-----"

# Trading Settings
# Options: CONSERVATIVE, AGGRESSIVE
ACTIVE_PROFILE=CONSERVATIVE

# Set DRY_RUN to True to simulate trades without executing them on Coinbase
DRY_RUN=True

# The product pair to trade (e.g., BTC-USD, ETH-USD)
TRADING_PAIR=BTC-USDC

# Amount of USD to use per trade (ensure this satisfies Coinbase's minimum requirements)
TRADE_AMOUNT_USD=25.0

# How often the bot runs its strategy loop (in seconds)
LOOP_INTERVAL_SECONDS=60

# The timeframe/candlestick size for the strategy (e.g. ONE_MINUTE, ONE_HOUR)
GRANULARITY=FIFTEEN_MINUTE


# ==============================================================================
# PROFILE SPECIFIC PARAMETERS
# ==============================================================================

# --- CONSERVATIVE PROFILE ---
CONSERVATIVE_SMA_SHORT_WINDOW=5
CONSERVATIVE_SMA_LONG_WINDOW=20
CONSERVATIVE_SMA_MIN_SPREAD_PERCENT=0.1
CONSERVATIVE_STOP_LOSS_PERCENT=1.0
CONSERVATIVE_TAKE_PROFIT_PERCENT=5.0
CONSERVATIVE_RSI_FILTER_ENABLED=True
CONSERVATIVE_RSI_PERIOD=14
CONSERVATIVE_RSI_BUY_MAX=60
CONSERVATIVE_RSI_SELL_MIN=40
CONSERVATIVE_EMA_TREND_FILTER_ENABLED=True
CONSERVATIVE_EMA_TREND_PERIOD=200

# --- AGGRESSIVE PROFILE ---
AGGRESSIVE_SMA_SHORT_WINDOW=12
AGGRESSIVE_SMA_LONG_WINDOW=35
AGGRESSIVE_SMA_MIN_SPREAD_PERCENT=0.03
AGGRESSIVE_STOP_LOSS_PERCENT=2.5
AGGRESSIVE_TAKE_PROFIT_PERCENT=4.0
AGGRESSIVE_RSI_FILTER_ENABLED=True
AGGRESSIVE_RSI_PERIOD=14
AGGRESSIVE_RSI_BUY_MAX=70
AGGRESSIVE_RSI_SELL_MIN=40
AGGRESSIVE_EMA_TREND_FILTER_ENABLED=False
AGGRESSIVE_EMA_TREND_PERIOD=200

