LEARNER_MODE=ADVISORY

# ── Portfolio guardrails ─────────────────────────────────────────────────────
# Every limit below is enforced PER BOT, against that bot's own state file.
# There is no cross-bot aggregation, so the portfolio figure is the per-bot
# value x 9 running bots. Sized accordingly.
#
# Reference at $10/trade: one stop-out costs ~$0.62 ($0.50 stop + $0.12 fees).
# All nine stopping out simultaneously loses ~$5.59 against $90 deployed.

# Hard ceiling per order. Well above TRADE_AMOUNT_USD so it never binds in
# normal operation, but a fat-fingered trade amount cannot place a large order.
MAX_VAL_PER_ORDER=15.0
MAX_EXPOSURE_PER_PRODUCT=15.0

# ~5 stop-outs on one coin in a day is anomalous, not a bad day.
# Portfolio backstop: 9 x $3.00 = $27 worst case.
MAX_DAILY_LOSS=3.0

# On hourly candles a crossover strategy should trade a few times a week, not
# a day. This is the churn circuit breaker — 6 trades/day costs $0.72 in fees
# on one coin alone, and churn is what the fee floor punishes.
MAX_TRADES_PER_DAY=6

# Halt buying after this many consecutive losses, for this long.
CONSECUTIVE_LOSS_COOLDOWN_TRADES=3
CONSECUTIVE_LOSS_COOLDOWN_SECONDS=10800

# ── Scale-up rule ────────────────────────────────────────────────────────────
# Fees are a percentage, so scaling multiplies gross AND fees equally. Raising
# TRADE_AMOUNT_USD on a negative-expectancy system only loses money faster.
# Do not increase it until, on the CURRENT config:
#   1. 30+ completed trades since the last parameter change
#   2. net P&L positive over those trades
#   3. positive on a majority of coins, not carried by one
#   4. the learner graduates at least one coin
# Then raise in steps (10 -> 25 -> 50), re-verifying 1-4 at each step, and
# raise MAX_VAL_PER_ORDER / MAX_EXPOSURE_PER_PRODUCT / MAX_DAILY_LOSS with it.

# ── Six-hour, all nine coins (2026-08-26) ───────────────────────────────────
# Every ONE_HOUR SMA window tested is negative out-of-sample; SIX_HOUR shows a
# plateau (8/30 through 15/45 all positive, peaking 10/40-12/40).
#
# Started as a 4-coin arm with 5 held back as an hourly control. The control was
# dropped the same day: it was measuring a configuration already proven negative
# at every parameter, so it was confirming a known answer while halving the rate
# at which the open question gets answered. The 53 completed hourly trades on
# record serve as the historical baseline instead.
#
# PARKED 2026-08-30, back on SIX_HOUR. Crypto is a finished experiment.
#
# This block briefly said ONE_HOUR, changed earlier the same day to raise the
# evidence rate from 0.48 to 3.0 trades/day. That change was wrong, and the
# reason it was wrong is the whole crypto result:
#
#   timeframe   best gross/trade   fee round trip   net/trade
#   ONE_HOUR          1.17%            1.206%         -0.14%
#   SIX_HOUR          2.59%            1.206%         +1.39%
#
# At hourly the average gross move is SMALLER than the fee. No parameter fixes
# that — removing the early exit, wider stops, bigger targets were all tested,
# selecting on in-sample and reporting out-of-sample, and every variant came
# out negative. You cannot capture 1.2% of movement from moves averaging 1.1%.
# The timeframe fast enough to verify cannot clear the fee; the timeframe that
# clears the fee needs ~12 months to verify.
#
# The fee lever is spent: the bot already sends post_only maker orders and
# 0.6%/side IS the maker rate. Lower tiers need ~$10k monthly volume against
# ~$900 actual.
#
# THE RESULT, from 53 real forward trades:
#   gross +0.794%/trade   fee -1.206%   net -0.412%/trade
#   19% win rate, net -$2.18, Sharpe -0.10 — fails 3 of 5 graduation criteria
#
# ⚠ CORRECTION 2026-08-31: the "+0.794% gross edge" above is NOT established.
# 95% confidence interval on those 53 trades is -0.353% to +1.940% — it
# includes zero. Per-trade standard deviation is 4.258%, so the noise is over
# five times the mean. The honest statement is not "the strategy picks
# direction and costs too much"; it is "we cannot tell whether it picks
# direction at all, and its best point estimate still loses to the fee."
#
# Resolving a 0.79% edge to +/-0.20% needs ~435 trades — about 30 months at
# six-hour. That, not the fee alone, is why crypto is parked.
#
# The strategy picks direction. It earns less than it costs to run. That is a
# verdict, not a tuning problem, and it was reached on a sample that cleared
# the 20-trade bar nearly threefold.
#
# PARKED means: bots keep running on six-hour so the record keeps accruing at
# no cost, and NOTHING here gets tuned. Do not re-open crypto on a backtest.
# Re-open only if the economics change — a materially lower fee tier, or a
# venue with maker fees well under 0.6%.
#
# One hypothesis left untested, recorded so it is not rediscovered: 41 of the
# 53 trades exited on "SMA Bearish Cross" averaging -1.62% net, while 7 take
# profit exits averaged +9.07%. The early exit may be cutting off the winners
# that pay for the fee. Six-hour backtests hint at this but rest on 10-18
# out-of-sample trades, which is too thin to act on.

BTC_GRANULARITY=SIX_HOUR
BTC_SMA_SHORT_WINDOW=10
BTC_SMA_LONG_WINDOW=40
SOL_GRANULARITY=SIX_HOUR
SOL_SMA_SHORT_WINDOW=10
SOL_SMA_LONG_WINDOW=40
LINK_GRANULARITY=SIX_HOUR
LINK_SMA_SHORT_WINDOW=10
LINK_SMA_LONG_WINDOW=40
SUI_GRANULARITY=SIX_HOUR
SUI_SMA_SHORT_WINDOW=10
SUI_SMA_LONG_WINDOW=40
ETH_GRANULARITY=SIX_HOUR
ETH_SMA_SHORT_WINDOW=10
ETH_SMA_LONG_WINDOW=40
ADA_GRANULARITY=SIX_HOUR
ADA_SMA_SHORT_WINDOW=10
ADA_SMA_LONG_WINDOW=40
XRP_GRANULARITY=SIX_HOUR
XRP_SMA_SHORT_WINDOW=10
XRP_SMA_LONG_WINDOW=40
NEAR_GRANULARITY=SIX_HOUR
NEAR_SMA_SHORT_WINDOW=10
NEAR_SMA_LONG_WINDOW=40
RENDER_GRANULARITY=SIX_HOUR
RENDER_SMA_SHORT_WINDOW=10
