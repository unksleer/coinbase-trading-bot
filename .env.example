STOCK_WATCHLIST=DIS,JNJ,LPL,META,PG,QQQ,SLV,SPY,TSLA,WMT,XLP,XLU

# ── Stock strategy (2026-08-26) ─────────────────────────────────────────────
# RSI_MEAN_REVERSION: buy when RSI crosses UP through oversold, sell when it
# crosses DOWN through overbought. The opposite bet to SMA crossover, which
# buys strength after a trend is confirmed.
#
# Measured across 15 symbols out-of-sample, mean reversion was positive on BOTH
# hourly and daily bars at every threshold tested (66-75% win rate) against
# crossover's 35-44%. 30/70 was the best on both timeframes.
#
# It works here and not on crypto because it takes many small moves: a 1% bounce
# is a loss against a 1.2% round-trip fee, and a win against ~0.20% slippage.
#
# The high win rate is not safety. Its failure mode is buying a decline that
# keeps declining, and the 5-year sample backing this is a bull market with no
# sustained downturn in it. STOP_LOSS_PERCENT is what bounds that.
# Stops widened from 2-3% to 5% when switching strategy. Measured across 15
# symbols, mean reversion nets +0.49 at SL 2.0/TP 4.0 and +8.47 at SL 5.0/TP 8.0,
# with a plateau from 4.0 through 8.0. A tight stop knocks you out of the dip
# before it finishes dipping, which is the entire premise of the strategy.
# 5.0/8.0 sits inside the plateau rather than on its peak, to avoid fitting it.
STOCK_STRATEGY=RSI_MEAN_REVERSION
STOCK_RSI_OVERSOLD=35
STOCK_RSI_OVERBOUGHT=65
